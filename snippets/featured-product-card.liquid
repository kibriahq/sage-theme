<div
  class="group flex flex-col bg-surface-container-lowest rounded-3xl p-4 shadow-sm hover:shadow-xl transition-all duration-300 relative"
>
  <div
    class="relative w-full aspect-[4/5] rounded-2xl overflow-hidden bg-surface-container mb-4"
  >
    <img
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      data-alt="Frosted glass bottle with organic face serum, eucalyptus plant and wooden accessories on stone table in clean botanical luxury room"
      src="{{ product.featured_image | img_url: '600x600' }}"
    />
    <!-- Sale Badge -->
    <span
      class="absolute top-3 left-3"
    >
      {% render 'product-badge', product: product %}
    </span>
    <!-- Wishlist Heart -->
    <button
      class="wishlist-btn absolute top-3 right-3 w-9 h-9 rounded-full bg-surface-container-lowest/80 backdrop-blur-sm flex items-center justify-center text-on-surface-variant hover:text-tertiary hover:scale-110 transition-all shadow-sm"
      type="button"
    >
      <span class="material-symbols-outlined text-[19px]">favorite</span>
    </button>
    <!-- Quick Add Slide-up Action -->
    <div
      class="absolute inset-x-3 bottom-3 translate-y-12 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300"
    >
      <button
        class="w-full py-3 rounded-xl bg-primary text-on-primary font-label-md text-label-md shadow-lg hover:bg-primary-container flex items-center justify-center gap-2"
        type="button"
      >
        <span class="material-symbols-outlined text-[18px]">add_shopping_cart</span>
        <span>Quick Add</span>
      </button>
    </div>
  </div>
  <div class="flex items-center gap-1 text-[#d97706] mb-1">
    <span
      class="material-symbols-outlined text-[15px]"
      style="font-variation-settings: 'FILL' 1;"
      >star</span
    >
    <span class="font-label-sm text-label-sm text-on-surface font-bold">4.9</span>
    <span class="font-body-sm text-[12px] text-on-surface-variant">(128 reviews)</span>
  </div>
  <h3
    class="font-headline-sm text-headline-sm text-on-surface font-semibold group-hover:text-primary transition-colors"
  >
    {{ product.title }}
  </h3>
  <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-1 mt-0.5">
    {{ product.metafields.custom.short_description }}
  </p>
  
  {% for option in product.options_with_values %}
    {% if option.name == 'Size' %}
      <div class="flex items-center gap-2 my-2.5">
        {% for value in option.values %}
          <span
            class="px-2.5 py-0.5 text-xs font-label-sm bg-surface-container text-on-surface-variant rounded-full"
          >
            {{- value -}}
          </span>
        {% endfor %}
      </div>
    {% endif %}
  {% endfor %}

  <!-- Swatches -->
  {% for option in product.options_with_values %}
    {% if option.name == 'Color' %}
      <div class="flex items-center gap-2 my-2.5">
        {% for value in option.values %}
          <button
            class="w-4 h-4 rounded-full hover:ring-2 hover:ring-outline hover:ring-offset-2 transition-all"
            title="Sage Extract"
            style="background-color: {{ value.swatch.color }};"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  {% endfor %}

  <div class="mt-auto pt-2 flex items-baseline gap-2">
    <span class="font-headline-sm text-[20px] text-on-surface font-bold">{{ product.price | money }}</span>
    <span
      class="font-body-sm text-body-sm text-on-surface-variant line-through"
    >
      {{- product.compare_at_price | money -}}
    </span>
  </div>
</div>
