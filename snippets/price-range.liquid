{% if filter.min_value.value %}
  {% assign min_value = filter.min_value.value | divided_by: 100.0 %}
{% else %}
  {% assign min_value = 0 %}
{% endif %}

{% if filter.max_value.value %}
  {% assign max_value = filter.max_value.value | divided_by: 100.0 %}
{% else %}
  {% assign max_value = filter.range_max | divided_by: 100.0 %}
{% endif %}
<!-- Filter Price Range -->
<div class="py-4 border-t-0 space-y-3">
  <div class="flex items-center justify-between font-label-lg text-label-lg text-on-surface font-semibold">
    <span>Price Range</span>
    {% comment %} <span class="font-label-sm text-label-sm text-primary font-bold">$15 – $95</span> {% endcomment %}
  </div>

  <div
    class="pt-2 pb-1 space-y-3"
    data-price-range
  >
    {% assign range_max = filter.range_max | divided_by: 100.0 | round | plus: 1 %}

    <div class="dual-price-slider">
      <div class="dual-price-track" data-range-track></div>

      <input
        class="dual-price-input"
        type="range"
        id="{{ filter.min_value.param_name }}"
        name="{{ filter.min_value.param_name }}"
        max="{{ range_max }}"
        min="0"
        value="{{ min_value | default: 0 }}"
        step="1"
        data-param="{{ filter.min_value.param_name }}"
        data-min-value
        aria-label="Minimum price"
      />

      <input
        class="dual-price-input"
        type="range"
        id="{{ filter.max_value.param_name }}"
        name="{{ filter.max_value.param_name }}"
        max="{{ range_max }}"
        min="0"
        value="{{ max_value | default: range_max }}"
        step="1"
        data-param="{{ filter.max_value.param_name }}"
        data-max-value
        aria-label="Maximum price"
      />
    </div>

    <div class="flex items-center justify-between gap-2">
      <div class="flex items-center bg-surface-container px-3 py-1.5 rounded-xl text-body-sm font-body-sm text-on-surface w-24">
        <span class="text-outline mr-1">$</span>
        <input
          class="w-full bg-transparent focus:outline-none text-on-surface font-medium"
          type="number"
          min="0"
          max="{{ range_max }}"
          step="1"
          value="{{ min_value | default: 0 }}"
          data-min-price
          aria-label="Minimum price"
        />
      </div>

      <span class="text-outline-variant font-label-sm text-label-sm">to</span>

      <div class="flex items-center bg-surface-container px-3 py-1.5 rounded-xl text-body-sm font-body-sm text-on-surface w-24">
        <span class="text-outline mr-1">$</span>
        <input
          class="w-full bg-transparent focus:outline-none text-on-surface font-medium"
          type="number"
          min="0"
          max="{{ range_max }}"
          step="1"
          value="{{ max_value | default: range_max }}"
          data-max-price
          aria-label="Maximum price"
        />
      </div>
    </div>
  </div>
</div>

<style>
  .dual-price-slider {
    --range-start: 0%;
    --range-end: 100%;

    position: relative;
    height: 24px;
    width: 100%;
  }

  .dual-price-track {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 100%;
    height: 6px;
    border-radius: 9999px;
    background: linear-gradient(
      to right,
      var(--color-surface-container, #e5e5e5) var(--range-start),
      var(--color-primary, #2563eb) var(--range-start),
      var(--color-primary, #2563eb) var(--range-end),
      var(--color-surface-container, #e5e5e5) var(--range-end)
    );
    pointer-events: none;
  }

  .dual-price-input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 24px;
    margin: 0;
    padding: 0;
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    pointer-events: none;
    cursor: pointer;
  }

  /* Hide the native track */
  .dual-price-input::-webkit-slider-runnable-track {
    height: 6px;
    background: transparent;
  }

  .dual-price-input::-moz-range-track {
    height: 6px;
    background: transparent;
  }

  /* Chrome, Safari, Edge */
  .dual-price-input::-webkit-slider-thumb {
    appearance: none;
    -webkit-appearance: none;
    pointer-events: auto;
    width: 18px;
    height: 18px;
    margin-top: -6px;
    border: 2px solid white;
    border-radius: 50%;
    background: var(--color-primary, #2563eb);
    box-shadow: 0 0 0 1px var(--color-primary, #2563eb);
    cursor: grab;
  }

  /* Firefox */
  .dual-price-input::-moz-range-thumb {
    pointer-events: auto;
    width: 14px;
    height: 14px;
    border: 2px solid white;
    border-radius: 50%;
    background: var(--color-primary, #2563eb);
    box-shadow: 0 0 0 1px var(--color-primary, #2563eb);
    cursor: grab;
  }

  .dual-price-input:focus-visible {
    outline: none;
  }

  .dual-price-input:focus-visible::-webkit-slider-thumb {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
</style>

<script>
  document.querySelectorAll('[data-price-range]').forEach((container) => {
    const minRange = container.querySelector('[data-min-value]');
    const maxRange = container.querySelector('[data-max-value]');
    const minPrice = container.querySelector('[data-min-price]');
    const maxPrice = container.querySelector('[data-max-price]');
    const track = container.querySelector('[data-range-track]');
    const slider = container.querySelector('.dual-price-slider');

    if (!minRange || !maxRange || !minPrice || !maxPrice || !track) {
      return;
    }

    const minLimit = Number(minRange.min) || 0;
    const maxLimit = Number(maxRange.max);
    const step = Number(minRange.step) || 1;

    function updateTrack() {
      const min = Number(minRange.value);
      const max = Number(maxRange.value);
      const range = maxLimit - minLimit || 1;

      slider.style.setProperty('--range-start', `${((min - minLimit) / range) * 100}%`);

      slider.style.setProperty('--range-end', `${((max - minLimit) / range) * 100}%`);

      // Keep the active thumb above the other thumb.
      minRange.style.zIndex = min >= max - step ? '5' : '3';
      maxRange.style.zIndex = min >= max - step ? '3' : '4';
    }

    function syncFromRange() {
      minPrice.value = minRange.value;
      maxPrice.value = maxRange.value;
      updateTrack();
    }

    minRange.addEventListener('input', () => {
      if (Number(minRange.value) >= Number(maxRange.value)) {
        minRange.value = Math.max(minLimit, Number(maxRange.value) - step);
      }

      syncFromRange();
    });

    maxRange.addEventListener('input', () => {
      if (Number(maxRange.value) <= Number(minRange.value)) {
        maxRange.value = Math.min(maxLimit, Number(minRange.value) + step);
      }

      syncFromRange();
    });

    minPrice.addEventListener('change', () => {
      let value = Number(minPrice.value);

      if (minPrice.value === '') return;

      value = Math.max(minLimit, Math.min(value, Number(maxRange.value) - step));

      minRange.value = value;
      syncFromRange();
    });

    maxPrice.addEventListener('change', () => {
      let value = Number(maxPrice.value);

      if (maxPrice.value === '') return;

      value = Math.min(maxLimit, Math.max(value, Number(minRange.value) + step));

      maxRange.value = value;
      syncFromRange();
    });

    updateTrack();
  });
</script>
