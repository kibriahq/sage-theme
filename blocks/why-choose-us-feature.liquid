<div class="p-6 rounded-2xl bg-surface-container-lowest shadow-sm flex flex-col gap-2.5">
  <div
    class="w-12 h-12 rounded-xl bg-secondary-container flex items-center justify-center text-primary"
  >
    <span class="text-[25px] flex items-center justify-center">
      {{ block.settings.icon }}
    </span>
  </div>
  <h3 class="font-headline-sm text-[18px] text-on-surface font-semibold">{{ block.settings.title }}</h3>
  <p class="font-body-sm text-body-sm text-on-surface-variant">
    {{ block.settings.description }}
  </p>
</div>

{% schema %}
{
  "name": "Feature",
  "settings": [
    {
      "type": "html",
      "id": "icon",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Feature",
      "category": "Custom"
    }
  ]
}
{% endschema %}
