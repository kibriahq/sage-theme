<div class="relative w-full aspect-[4/5] max-h-[580px] rounded-3xl overflow-hidden shadow-xl bg-surface-container-low group">
  <img
    class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
    data-alt="Editorial still life of luxurious frosted glass herbal skincare serum bottles with bamboo droppers on a sunlit stone vanity ledge beside eucalyptus branches in a textured ceramic vase, peaceful morning atmosphere"
    src="{{ section.settings.hero_image | default: 'https://lh3.googleusercontent.com/aida-public/AB6AXuD8jodXt4hc_HarpYaTTYW0wHDgLxt_z54VKQ7YfD31-Znm6cqkqJQDvCwHh9PyAhZlXgK6VQwvQd9Jc7S2PO84xZVq1jsPRmVs4uu5PNz_sMZivfGjjqgUc-hH118jJ_Uf39Fqa1HcndvgPEbidodGuixGSUjJAaNRD4IGOSdwWUfqhjg-PN66w2luBYZMHJ2ehHKhq3o3B2LpeC2l5FCIxgtSqCK5pjpuyj8NwzkXH9OXl4InB_wIXQ' }}"
  />
  <!-- Soft Gradient Overlay -->
  <div
    class="absolute inset-0 bg-gradient-to-t from-inverse-surface/30 via-transparent to-transparent pointer-events-none"
  ></div>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Hero Media",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    }
  ],
  "blocks": [
    {
      "type": "hero-media-badge-top"
    },
    {
      "type": "hero-media-badge-bottom"
    }
  ],
  "presets": [
    {
      "name": "Hero Media"
    }
  ]
}
{% endschema %}
