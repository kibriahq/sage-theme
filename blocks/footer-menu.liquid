<div class="flex flex-col gap-space-sm">
  <h3 class="font-label-lg text-label-lg text-on-surface uppercase tracking-wider font-semibold">
    {{ block.settings.footer_menu.title }}
  </h3>
  <ul class="flex flex-col gap-space-xs">
    {% for link in block.settings.footer_menu.links %}
      <li
        class="font-body-sm text-body-sm text-on-surface-variant hover:text-primary transition-colors"
      >
        <a href="{{ link.url }}">{{ link.title }}</a>
      </li>
    {% endfor %}
  </ul>
</div>

{% schema %}
  {
    "name": "Footer Menu",
    "settings": [
      {
        "type": "link_list",
        "id": "footer_menu",
        "label": "Select Footer Menu"
      }
    ],
    "presets": [
      {
        "name": "Footer Menu"
      }
    ]
  }
{% endschema %}