<div
  class="pt-space-md flex flex-col md:flex-row items-center {% if block.settings.show_payment_icons %}justify-between{% else %}justify-center{% endif %} gap-space-md bg-surface-container-high/40 rounded-xl px-space-md py-space-sm"
>
  {% if block.settings.show_payment_icons %}
    <div class="flex items-center flex-wrap gap-2 text-on-surface-variant font-label-sm text-label-sm">
      {% for type in shop.enabled_payment_types %}
        {{ type | payment_type_svg_tag }}
      {% endfor %}
    </div>
  {% endif %}
  <p class="font-body-sm text-body-sm text-on-surface-variant">{{ block.settings.copyright_text }}</p>
</div>

{% schema %}
{
  "name": "Footer Bottom",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show Payment Icons",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "© 2026 Verdant Living. All rights reserved."
    }
  ]
}
{% endschema %}
