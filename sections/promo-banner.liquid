<section class="py-space-xl">
  <div
    class="relative w-full rounded-3xl bg-gradient-to-br from-surface-container to-secondary-container/60 p-8 sm:p-12 lg:p-16 overflow-hidden shadow-sm"
  >
    <!-- Background Organic Shape -->
    <div
      class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-primary/10 blur-2xl pointer-events-none"
    ></div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-center relative z-10">
      {% content_for 'blocks' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo Banner",
  "settings": [],
  "blocks": [
    {
      "type": "promo-left-group"
    },
    {
      "type": "promo-right-group"
    }
  ],
  "presets": [
    {
      "name": "Promo Banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}
