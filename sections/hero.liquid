<section class="py-space-lg lg:py-space-xl">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter lg:gap-space-lg items-center">
    <!-- Hero Left Column -->
    <div class="lg:col-span-6 flex flex-col items-start gap-space-md z-10">
      {% content_for 'block', type: 'hero-badge', id: 'hero-badge' %}
      <div class="flex flex-col gap-space-sm">
        {% content_for 'block', type: 'hero-heading', id: 'hero-heading' %}
        {% content_for 'block', type: 'hero-description', id: 'hero-description' %}
      </div>
      <!-- CTAs -->
      {% content_for 'block', type: 'hero-btns', id: 'hero-btns' %}
      <!-- Social Proof Trust Row -->
      {% content_for 'block', type: 'hero-social-proof', id: 'hero-social-proof' %}
    </div>
    <!-- Hero Right Column Showcase -->
    <div class="lg:col-span-6 relative mt-8 lg:mt-0">
      {% content_for 'block', type: 'hero-media', id: 'hero-media' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [],
  "presets": [
    {
      "name": "Hero Section"
    }
  ]
}
{% endschema %}
