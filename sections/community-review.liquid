<section>
  <!-- Testimonial Carousel Block -->
  <div class="flex flex-col items-center">
    <div class="text-center mb-space-lg">
      <span
        class="font-label-md text-label-md text-primary uppercase tracking-widest block mb-1"
        >{{ section.settings.subtitle }}</span
      >
      <h2 class="font-headline-lg text-headline-lg text-on-surface font-medium">{{ section.settings.title }}</h2>
    </div>
    <!-- 3 Cards Layout -->
    <!-- Slider main container -->
    <div class="swiper mySwiper">
      <!-- Additional required wrapper -->
      <div class="swiper-wrapper">
        <!-- Slides -->
        {% content_for 'blocks' %}
      </div>
      <!-- If we need pagination -->
    </div>
    <!-- Pagination Dots & Controls -->
    <div class="flex items-center gap-4 mt-space-md">
      <button
        class="swiper-button-prev w-9 h-9 rounded-full bg-surface-container flex items-center justify-center text-on-surface hover:bg-primary hover:text-on-primary transition-colors"
        type="button"
      >
        <span class="material-symbols-outlined text-lg">chevron_left</span>
      </button>
      <div class="">
        <div class="swiper-pagination"></div>
      </div>
      <button
        class="swiper-button-next w-9 h-9 rounded-full bg-surface-container flex items-center justify-center text-on-surface hover:bg-primary hover:text-on-primary transition-colors"
        type="button"
      >
        <span class="material-symbols-outlined text-lg">chevron_right</span>
      </button>
    </div>
  </div>
</section>

<style>
  .swiper {
    width: 100%;
    height: 100%;
  }

  .swiper-slide {
    text-align: center;
    font-size: 18px;
    background: #444;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .swiper-slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<script type="module">
  import Swiper from 'https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.mjs';

  const swiper = new Swiper('.mySwiper', {
    slidesPerView: 3,
    spaceBetween: 30,
    // Optional parameters
    direction: 'horizontal',
    loop: true,

    // If we need pagination
    pagination: {
      el: '.swiper-pagination',
      clickable: true,
    },

    // Navigation arrows
    navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
    },
  });
</script>

{% schema %}
{
  "name": "Community Review",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Loved By Conscious Seekers"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Kind Words From Our Community"
    }
  ],
  "blocks": [
    {
      "type": "review-slide"
    }
  ],
  "presets": [
    {
      "name": "Community Review",
      "category": "Custom"
    }
  ]
}
{% endschema %}
