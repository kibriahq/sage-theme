<section class="py-space-xl mb-space-md">
  <div
    class="relative w-full rounded-3xl bg-surface-container p-8 sm:p-12 lg:p-16 text-center overflow-hidden shadow-sm"
  >
    <newsletter-form>
      <div class="max-w-2xl mx-auto flex flex-col items-center gap-space-sm relative z-10">
        <div
          class="w-12 h-12 rounded-full bg-secondary-container flex items-center justify-center text-primary mb-1"
        >
          <span class="material-symbols-outlined text-2xl">mail</span>
        </div>
        <span
          class="font-label-md text-label-md text-primary uppercase tracking-widest font-bold"
        >
          {{- section.settings.subtitle -}}
        </span>
        <h2 class="font-headline-lg text-headline-lg text-on-surface font-medium leading-tight">
          {{ section.settings.title }}
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
          {{ section.settings.description }}
        </p>
        <!-- Email Input Form -->
        {% comment %}
          <form
            class="w-full max-w-md mt-2 flex flex-col sm:flex-row gap-2 bg-surface-container-lowest p-1.5 rounded-2xl shadow-sm"
            onsubmit="event.preventDefault(); document.getElementById('newsletter-success').classList.remove('hidden');"
          >
        {% endcomment %}
        {% form 'customer',
          class: 'w-full max-w-md mt-2 flex flex-col sm:flex-row gap-2 bg-surface-container-lowest p-1.5 rounded-2xl shadow-sm'
        %}
          <input
            type="hidden"
            name="contact[tags]"
            value="newsletter"
          />
          <input
            class="w-full px-4 py-3 bg-transparent text-on-surface placeholder:text-outline font-body-md text-body-md rounded-xl focus:outline-none"
            placeholder="Enter your email address..."
            type="email"
            name="contact[email]"
            autocapitalize="off"
            autocorrect="off"
            required
          />
          <button
            class="px-7 py-3 rounded-xl bg-primary text-on-primary font-label-md text-label-md whitespace-nowrap hover:bg-primary-container transition-all shadow-md"
            type="submit"
          >
            Subscribe
          </button>
        {% endform %}

        <span
          class="hidden text-primary font-label-sm text-label-sm bg-secondary-container/80 px-4 py-1.5 rounded-full"
          id="newsletter-success"
        >
          {{ section.settings.success_message }}
        </span>

        <span
          class="hidden text-red-400 font-label-sm text-label-sm bg-red-200/80 px-4 py-1.5 rounded-full"
          id="newsletter-error"
        >
          ❌ There was an error submitting the form. Please try again.
        </span>

        {% comment %} </form> {% endcomment %}
        <span class="font-body-sm text-[12px] text-on-surface-variant">
          {{ section.settings.disclaimer }}
        </span>
      </div>
    </newsletter-form>
  </div>
</section>

<script src="{{ 'newsletter.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The Botanical Journal"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Join the Verdant Circle"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Receive 15% off your first order, private seasonal releases, and mindful weekly botanical recipes directly to your inbox."
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "✨ Welcome to the circle! Check your inbox for your 15% code."
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "No spam ever. Unsubscribe at any time with a single click."
    }
  ]
}
{% endschema %}
