<!-- You May Also Like (Related Products) -->
<section class="w-full max-w-7xl mx-auto px-margin-mobile lg:px-margin py-14">
  <div class="flex items-center justify-between mb-8">
    <div>
      <span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest font-semibold"
        >Related Products</span
      >
      <h2 class="font-headline-lg text-headline-lg text-on-surface tracking-tight mt-1">You May Also Like</h2>
    </div>
    {% if false %}
      <div class="flex items-center gap-2">
        <button
          aria-label="Previous product"
          class="w-10 h-10 rounded-full bg-surface-container-lowest shadow-sm flex items-center justify-center text-on-surface hover:bg-primary hover:text-on-primary transition-colors"
          type="button"
        >
          <span class="material-symbols-outlined text-[20px]">arrow_back</span>
        </button>
        <button
          aria-label="Next product"
          class="w-10 h-10 rounded-full bg-surface-container-lowest shadow-sm flex items-center justify-center text-on-surface hover:bg-primary hover:text-on-primary transition-colors"
          type="button"
        >
          <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
        </button>
      </div>
    {% endif %}
  </div>
  <!-- Product Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {% for product in product.collections.last.products limit: 8 %}
      <div class="bg-surface-container-lowest rounded-2xl p-4 shadow-sm group flex flex-col justify-between hover:shadow-md transition-all">
        <div>
          <div class="relative w-full aspect-square rounded-xl bg-surface-container-low overflow-hidden mb-4">
            <img
              alt="{{ product.title }}"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              src="{{ product.featured_image | img_url: '600x600' }}"
            />
            <span class="absolute top-3 left-3">
              {% render 'product-badge', product: product %}
            </span>
            <button
              class="absolute bottom-3 left-3 right-3 bg-primary text-on-primary py-2.5 rounded-xl font-label-md text-label-md font-medium shadow-md opacity-0 group-hover:opacity-100 transition-all translate-y-2 group-hover:translate-y-0 flex items-center justify-center gap-2"
              type="button"
            >
              <span class="material-symbols-outlined text-[18px]">add_shopping_cart</span>
              Quick Add
            </button>
          </div>
          <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">{{ product.vendor }}</span>
          <h3 class="font-headline-sm text-headline-sm text-on-surface mt-1 line-clamp-1">
            <a href="{{ product.url }}">{{ product.title }}</a>
          </h3>
          <div class="flex items-center gap-1 text-primary text-xs mt-1">
            <span
              class="material-symbols-outlined text-[15px]"
              style="font-variation-settings: 'FILL' 1;"
              >star</span
            >
            <span class="font-medium text-on-surface">5.0</span>
            <span class="text-on-surface-variant">(42)</span>
          </div>
        </div>
        <div class="pt-4 flex items-center justify-between">
          <span class="font-headline-sm text-headline-sm text-on-surface font-semibold">
            {{- product.price | money -}}
          </span>
          {% if product.available %}
            <span class="font-label-sm text-label-sm text-on-surface-variant bg-surface-container px-2.5 py-1 rounded-md">
              In Stock
            </span>
          {% else %}
            <span class="font-label-sm text-label-sm bg-red-400/80 text-red-700 px-2.5 py-1 rounded-md">
              Out of Stock
            </span>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Related Products",
  "settings": []
}
{% endschema %}
