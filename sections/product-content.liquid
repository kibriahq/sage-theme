<!-- Product Content Section -->
{% if product.metafields.custom.story_heading %}
  <section class="w-full bg-surface-container-low py-16 my-8">
    <div class="max-w-7xl mx-auto px-margin-mobile lg:px-margin">
      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center bg-surface-container-lowest rounded-2xl p-8 lg:p-12 shadow-sm"
      >
        <div class="lg:col-span-6 flex flex-col gap-6">
          <div>
            <span class="text-tertiary font-label-sm text-label-sm uppercase tracking-wider font-semibold">
              {{- product.metafields.custom.story_eyebrow -}}
            </span>
            <h3 class="font-headline-md text-headline-md text-on-surface mt-1 mb-3">
              {{ product.metafields.custom.story_heading }}
            </h3>
            <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
              {{ product.metafields.custom.story_description }}
            </p>
          </div>
          <!-- 4 Pillars Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            {% for feature in product.metafields.custom.feature_cards.value %}
              <div class="p-4 rounded-xl bg-surface-container-low flex items-start gap-3">
                <span class="text-primary text-[24px]">{{ feature.icon }}</span>
                <div>
                  <h4 class="font-label-md text-label-md text-on-surface font-semibold">{{ feature.title }}</h4>
                  <p class="font-body-sm text-body-sm text-on-surface-variant">
                    {{ feature.description }}
                  </p>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
        {% if product.metafields.custom.story_image %}
          <div class="lg:col-span-6 relative aspect-square sm:aspect-[4/3] rounded-2xl overflow-hidden shadow-sm">
            <img
              class="w-full h-full object-cover"
              data-alt="Serene bathroom counter ritual setting with frosted glass skincare elixir bottle, ceramic vase with leafy eucalyptus sprigs, and warm beige linen hand towel in gentle sunlight."
              src="{{ product.metafields.custom.story_image | img_url: '2048x2048' }}"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-inverse-surface/40 via-transparent to-transparent flex items-end p-6"
            >
              <p
                class="text-on-primary font-body-sm text-body-sm backdrop-blur-sm bg-inverse-surface/30 px-4 py-2 rounded-xl"
              >
                "{{ product.metafields.custom.story_image_quote }}"
              </p>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </section>
{% endif %}
{% schema %}
{
  "name": "Product Content",
  "settings": []
}
{% endschema %}
