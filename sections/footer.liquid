<footer class="w-full bg-surface-container-low pt-space-xl pb-space-lg">
  <div class="max-w-7xl mx-auto px-margin-mobile lg:px-margin">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter lg:gap-space-lg pb-space-xl">
      {% content_for 'block', type: 'footer-brand', id: 'footer-brand' %}
      {% content_for 'blocks' %}
    </div>
    {% content_for 'block', type: 'footer-bottom', id: 'footer-bottom' %}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "footer-menu"
    }
  ]
}
{% endschema %}
