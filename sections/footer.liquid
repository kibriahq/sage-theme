<footer class="w-full bg-surface-container-low pt-space-xl pb-space-lg">
  <div class="max-w-7xl mx-auto px-margin-mobile lg:px-margin">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter lg:gap-space-lg pb-space-xl">
      <div class="flex flex-col gap-space-sm">
        <span
          class="font-headline-sm text-headline-sm text-on-surface font-medium"
        >
          {{- section.settings.brand_name -}}
        </span>
        <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
          {{ section.settings.footer_text }}
        </p>
        <div class="flex items-center gap-space-sm pt-space-xs flex-wrap">
          {% for block in section.blocks %}
            {% if block.type == 'social_links' and block.settings.url != blank %}
              <a
                aria-label="{{ block.settings.platform | capitalize }}"
                class="w-9 h-9 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant hover:bg-slate-300/90 hover:text-on-primary transition-colors"
                target="_blank"
                href="{{ block.settings.url }}"
              >
                <ion-icon name="logo-{{ block.settings.platform }}"></ion-icon>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      <div class="flex flex-col gap-space-sm">
        <h3 class="font-label-lg text-label-lg text-on-surface uppercase tracking-wider font-semibold">
          {{ section.settings.footer_menu_1.title }}
        </h3>
        <ul class="flex flex-col gap-space-xs">
          {% for link in section.settings.footer_menu_1.links %}
            <li
              class="font-body-sm text-body-sm text-on-surface-variant hover:text-primary transition-colors"
            >
              <a href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </div>
      <div class="flex flex-col gap-space-sm">
        <h3 class="font-label-lg text-label-lg text-on-surface uppercase tracking-wider font-semibold">
          {{ section.settings.footer_menu_2.title }}
        </h3>
        <ul class="flex flex-col gap-space-xs">
          {% for link in section.settings.footer_menu_2.links %}
            <li
              class="font-body-sm text-body-sm text-on-surface-variant hover:text-primary transition-colors"
            >
              <a href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </div>
      <div class="flex flex-col gap-space-sm">
        <h3 class="font-label-lg text-label-lg text-on-surface uppercase tracking-wider font-semibold">
          {{ section.settings.footer_menu_3.title }}
        </h3>
        <ul class="flex flex-col gap-space-xs">
          {% for link in section.settings.footer_menu_3.links %}
            <li
              class="font-body-sm text-body-sm text-on-surface-variant hover:text-primary transition-colors"
            >
              <a href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
    <div
      class="pt-space-md flex flex-col md:flex-row items-center justify-between gap-space-md bg-surface-container-high/40 rounded-xl px-space-md py-space-sm"
    >
      <div class="flex items-center flex-wrap gap-2 text-on-surface-variant font-label-sm text-label-sm">
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag }}
        {% endfor %}
      </div>
      <p class="font-body-sm text-body-sm text-on-surface-variant">{{ section.settings.footer_copyright_text }}</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "Verdant Living"
    },
    {
      "type": "textarea",
      "id": "footer_text",
      "label": "Footer Text",
      "default": "Botanical luxury crafted for conscious living. Pure, organic formulations and regenerative wellness essentials grown with earth-first integrity."
    },
    {
      "type": "link_list",
      "id": "footer_menu_1",
      "label": "First Footer Menu"
    },
    {
      "type": "link_list",
      "id": "footer_menu_2",
      "label": "Second Footer Menu"
    },
    {
      "type": "link_list",
      "id": "footer_menu_3",
      "label": "Third Footer Menu"
    },
    {
      "type": "text",
      "id": "footer_copyright_text",
      "label": "Footer Copyright Text",
      "default": "© 2026 Verdant Living. All rights reserved."
    }
  ],
  "blocks": [
    {
      "type": "social_links",
      "name": "Social Links",
      "settings": [
        {
          "type": "select",
          "id": "platform",
          "label": "Platform",
          "options": [
            {
              "value": "instagram",
              "label": "Instagram"
            },
            {
              "value": "x",
              "label": "X"
            },
            {
              "value": "pinterest",
              "label": "Pinterest"
            },
            {
              "value": "facebook",
              "label": "Facebook"
            },
            {
              "value": "youtube",
              "label": "YouTube"
            },
            {
              "value": "tiktok",
              "label": "TikTok"
            },
            {
              "value": "linkedin",
              "label": "LinkedIn"
            }
          ]
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ]
}
{% endschema %}
