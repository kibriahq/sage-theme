<!-- Sticky Bottom Add-to-Cart Bar (Floats on scroll) -->
<div
  class="fixed bottom-0 left-0 right-0 z-40 bg-surface/90 backdrop-blur-xl shadow-lg border-t border-surface-container transform translate-y-full transition-transform duration-300"
  id="sticky-cart-bar"
>
  <div class="max-w-7xl mx-auto px-margin-mobile lg:px-margin py-3 flex items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-12 h-12 rounded-xl bg-surface-container-lowest overflow-hidden shadow-sm shrink-0">
        <img
          class="w-full h-full object-cover"
          data-alt="Macro close-up shot of amber glass dropper bottle holding golden herbal facial elixir with liquid droplet falling onto smooth pale stone pedestal surrounded by fresh green eucalyptus leaves in soft morning light."
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuCm6rQ8S1X49MPW-lFzTYPXYNNP06-iwO0k25ginx28gVvXZ7zF7G-0pqOOS0kEB955KqGYa__b549-dKHAqtyBwpc5PXWWjQCTphCYTG5AzFq-OELemzpBgdVZPkaczXAqsUxxKlNe_7x1oIvNcULibs1rfiR42NbV2XY_v5rdIDZ-34Dp4ydcNurG5z4jdNg2RweqysAp8nMa01isDpIa8xfy0N60IxgcKKU5xCEZNPUywvFTEL_EkA"
        />
      </div>
      <div class="hidden sm:block">
        <h4 class="font-label-lg text-label-lg text-on-surface font-semibold">Luna Hydrate &amp; Renew Serum</h4>
        <span class="font-body-sm text-body-sm text-on-surface-variant">50ml / 1.7 fl oz • Batch #042</span>
      </div>
    </div>
    <div class="flex items-center gap-4">
      <div class="text-right">
        <span class="font-headline-sm text-headline-sm font-bold text-on-surface">$54.00</span>
        <span class="text-xs line-through text-outline block sm:inline ml-1">$68.00</span>
      </div>
      <button
        class="bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md py-3 px-6 rounded-xl shadow-sm transition-all flex items-center gap-2 font-medium"
        type="button"
      >
        <span class="material-symbols-outlined text-[18px]">shopping_bag</span>
        <span>Add to Cart</span>
      </button>
    </div>
  </div>
</div>

<script>
  // Simple client-side micro-interactions
  (function () {
    // Gallery Thumb Switching
    const thumbs = document.querySelectorAll('.gallery-thumb');
    const mainImg = document.getElementById('main-product-img');
    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        thumbs.forEach((t) => {
          t.classList.remove('ring-2', 'ring-primary', 'opacity-100');
          t.classList.add('opacity-75');
        });
        thumb.classList.add('ring-2', 'ring-primary', 'opacity-100');
        thumb.classList.remove('opacity-75');
        const img = thumb.querySelector('img');
        if (img && mainImg) {
          mainImg.src = img.src;
          if (img.getAttribute('data-alt')) {
            mainImg.setAttribute('data-alt', img.getAttribute('data-alt'));
          }
        }
      });
    });

    // Wishlist Toggle
    const wishBtn = document.getElementById('wishlist-btn');
    const wishIcon = document.getElementById('wishlist-icon');
    let isWished = false;
    if (wishBtn && wishIcon) {
      wishBtn.addEventListener('click', () => {
        isWished = !isWished;
        wishIcon.textContent = isWished ? 'favorite' : 'favorite_border';
        wishIcon.style.color = isWished ? '#95423c' : '';
      });
    }

    // Size Selection
    const sizeButtons = document.querySelectorAll('#size-options button[data-size]');
    const priceDisplay = document.getElementById('display-price');
    const btnPriceDisplay = document.getElementById('btn-price-hero');
    const sizeLabel = document.getElementById('selected-size-label');

    sizeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        sizeButtons.forEach((b) => {
          b.className =
            'py-2.5 px-2 rounded-xl text-center font-label-md text-label-md transition-all bg-surface-container text-on-surface-variant hover:bg-surface-container-high';
        });
        btn.className =
          'py-2.5 px-2 rounded-xl text-center font-label-md text-label-md transition-all bg-primary-container text-on-primary-container shadow-sm ring-2 ring-primary';
        const p = btn.getAttribute('data-price');
        const s = btn.getAttribute('data-size');
        if (priceDisplay) priceDisplay.textContent = p;
        if (btnPriceDisplay) btnPriceDisplay.textContent = p;
        if (sizeLabel)
          sizeLabel.textContent = s + ' / ' + (s === '30ml' ? '1.0 fl oz' : s === '50ml' ? '1.7 fl oz' : '3.4 fl oz');
      });
    });

    // Quantity Counter
    let qty = 1;
    const qtyDisplay = document.getElementById('qty-display');
    const qtyMinus = document.getElementById('qty-minus');
    const qtyPlus = document.getElementById('qty-plus');

    if (qtyMinus && qtyPlus && qtyDisplay) {
      qtyMinus.addEventListener('click', () => {
        if (qty > 1) {
          qty--;
          qtyDisplay.textContent = qty;
        }
      });
      qtyPlus.addEventListener('click', () => {
        qty++;
        qtyDisplay.textContent = qty;
      });
    }

    // Sticky Bottom Bar on Scroll
    const stickyBar = document.getElementById('sticky-cart-bar');
    window.addEventListener('scroll', () => {
      if (!stickyBar) return;
      if (window.scrollY > 600) {
        stickyBar.classList.remove('translate-y-full');
      } else {
        stickyBar.classList.add('translate-y-full');
      }
    });

    // Tab pills
    const tabButtons = document.querySelectorAll('.tab-btn');
    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabButtons.forEach((b) => {
          b.className =
            'tab-btn px-5 py-2 rounded-full font-label-md text-label-md text-on-surface-variant hover:text-on-surface';
        });
        btn.className =
          'tab-btn px-5 py-2 rounded-full font-label-md text-label-md bg-surface-container-lowest text-primary shadow-sm font-semibold';
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Sticky Add to Cart",
  "blocks": [],
  "settings": []
}
{% endschema %}
